{
  "name": "@koffeekat/diana",
  "version": "0.1.0-beta.1",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "description": "Fast, lightweight data search layer for agents.",
  "keywords": [
    "diana",
    "koffeekat",
    "llm",
    "ai",
    "agent",
    "search",
    "data",
    "pi-package"
  ],
  "author": "koffeekat",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "pretest": "npm run build",
    "build": "tsc",
    "prepack": "npm run build",
    "check": "tsc --project tsconfig.test.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "bin": {
    "diana": "dist/cli.js"
  },
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "dist/",
    "skills/",
    ".claude-plugin/",
    "docs/security.md",
    "img/"
  ],
  "devDependencies": {
    "@types/node": "^26.6.4",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
